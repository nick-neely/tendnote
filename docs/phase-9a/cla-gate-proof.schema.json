{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nick-neely/tendnote/blob/main/docs/phase-9a/cla-gate-proof.schema.json",
  "title": "Redacted CLA gate qualification evidence",
  "description": "A public-safe shape for recording the observed CLA status and disposable cases. It intentionally has no signer, contact, agreement-record, Gist, or account fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "commit",
    "agreement",
    "ruleset",
    "cases",
    "redaction"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "repository": {
      "const": "nick-neely/tendnote"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {
          "const": "1.0"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "observedAt", "requiredStatusContexts", "claStatusContext"],
      "properties": {
        "id": {
          "const": 19995472
        },
        "name": {
          "const": "Protect main"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "requiredStatusContexts": {
          "type": "array",
          "const": ["Verify", "Full CI qualification", "Vercel"]
        },
        "claStatusContext": {
          "type": "string",
          "pattern": "^(?!CLA_STATUS_CONTEXT_TO_OBSERVE_LIVE$)\\S(?:.*\\S)?$"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "proofId",
          "status",
          "outcome",
          "observedAt",
          "claStatusContext",
          "identity"
        ],
        "properties": {
          "kind": {
            "enum": ["unsigned", "accepted", "employer", "corporate"]
          },
          "proofId": {
            "type": "string",
            "pattern": "^redacted-[a-z0-9-]+$"
          },
          "status": {
            "enum": ["failure", "success"]
          },
          "outcome": {
            "enum": ["open-unmergeable", "eligible"]
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "claStatusContext": {
            "type": "string",
            "pattern": "^(?!CLA_STATUS_CONTEXT_TO_OBSERVE_LIVE$)\\S(?:.*\\S)?$"
          },
          "identity": {
            "const": "redacted"
          }
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identities",
        "contactDetails",
        "acceptanceRecords",
        "temporaryPullRequests",
        "gistReferences"
      ],
      "properties": {
        "identities": {
          "const": true
        },
        "contactDetails": {
          "const": true
        },
        "acceptanceRecords": {
          "const": true
        },
        "temporaryPullRequests": {
          "const": true
        },
        "gistReferences": {
          "const": true
        }
      }
    }
  }
}
