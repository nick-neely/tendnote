{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nick-neely/tendnote/blob/main/docs/phase-9a/publication-qualification.schema.json",
  "title": "Tendnote Phase 9a publication qualification report",
  "description": "A fail-closed, exact-candidate report. A report is qualified only when every required gate and every listed criterion is passed with evidence tied to the candidate commit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "repository",
    "generatedAt",
    "candidate",
    "result",
    "gates",
    "boundary"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "tendnote.phase-9a.publication-qualification" },
    "repository": { "const": "nick-neely/tendnote" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "candidate": { "$ref": "#/$defs/candidate" },
    "result": { "$ref": "#/$defs/result" },
    "gates": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/gate" }
    },
    "boundary": { "$ref": "#/$defs/boundary" }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": ["passed", "blocked", "pending", "failed", "skipped", "recovered", "stale", "not-run"]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "visibility", "immutable"],
      "properties": {
        "commit": { "$ref": "#/$defs/sha" },
        "visibility": { "enum": ["private", "public", "unknown"] },
        "immutable": { "const": true }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "clean", "blockers"],
      "properties": {
        "status": { "enum": ["blocked", "qualified"] },
        "clean": { "type": "boolean" },
        "blockers": {
          "type": "array",
          "items": { "$ref": "#/$defs/blocker" }
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateId", "code", "message"],
      "properties": {
        "gateId": { "type": "string", "minLength": 1 },
        "criterionId": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCommit", "sha256"],
      "anyOf": [{ "required": ["path"] }, { "required": ["uri"] }],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "format": "uri", "minLength": 1 },
        "sourceCommit": { "$ref": "#/$defs/sha" },
        "sha256": { "$ref": "#/$defs/digest" },
        "format": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "evidence", "blockers"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "summary": { "type": "string", "minLength": 1 },
        "binding": { "$ref": "#/$defs/binding" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "blockers": {
          "type": "array",
          "items": { "$ref": "#/$defs/blocker" }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["github-issue", "github-setting"] },
        "issue": { "type": "integer", "minimum": 1 },
        "setting": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        {
          "required": ["source", "issue", "state"],
          "properties": {
            "source": { "const": "github-issue" },
            "issue": { "type": "integer", "minimum": 1 },
            "state": { "type": "string", "minLength": 1 }
          }
        },
        {
          "required": ["source", "setting", "state"],
          "properties": {
            "source": { "const": "github-setting" },
            "setting": { "type": "string", "minLength": 1 },
            "state": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "required", "status", "criteria", "evidence", "blockers"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "required": { "const": true },
        "status": { "$ref": "#/$defs/status" },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/criterion" }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "blockers": {
          "type": "array",
          "items": { "$ref": "#/$defs/blocker" }
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryPublication", "externalSends"],
      "properties": {
        "repositoryPublication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "visibilityMutationPerformed"],
          "properties": {
            "status": { "enum": ["pending-owner-approval", "approved", "not-requested"] },
            "visibilityMutationPerformed": { "const": false }
          }
        },
        "externalSends": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "performed"],
          "properties": {
            "status": { "const": "none" },
            "performed": { "const": false }
          }
        }
      }
    }
  }
}
