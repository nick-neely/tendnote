{
  "name": "@tendnote/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./schema": "./src/schema/index.ts",
    "./queries/access-profiles": "./src/queries/access-profiles.ts",
    "./queries/auth-users": "./src/queries/auth-users.ts",
    "./queries/background-job-deliveries": "./src/queries/background-job-deliveries.ts",
    "./queries/birthday-gift-planning": "./src/queries/birthday-gift-planning.ts",
    "./queries/brief-schedules": "./src/queries/brief-schedules.ts",
    "./queries/briefs": "./src/queries/briefs.ts",
    "./queries/calendar": "./src/queries/calendar.ts",
    "./queries/calendar-followups": "./src/queries/calendar-followups.ts",
    "./queries/contacts-import-preview": "./src/queries/contacts-import-preview.ts",
    "./queries/contact-methods": "./src/queries/contact-methods.ts",
    "./queries/context-snapshots": "./src/queries/context-snapshots.ts",
    "./queries/draft-proposals": "./src/queries/draft-proposals.ts",
    "./queries/drafts": "./src/queries/drafts.ts",
    "./queries/extraction-jobs": "./src/queries/extraction-jobs.ts",
    "./queries/followups": "./src/queries/followups.ts",
    "./queries/gmail-drafts": "./src/queries/gmail-drafts.ts",
    "./queries/memory-curator": "./src/queries/memory-curator.ts",
    "./queries/memories": "./src/queries/memories.ts",
    "./queries/morning-agenda": "./src/queries/morning-agenda.ts",
    "./queries/people": "./src/queries/people.ts",
    "./queries/post-meeting-aftercare": "./src/queries/post-meeting-aftercare.ts",
    "./queries/provider-connections": "./src/queries/provider-connections.ts",
    "./queries/scheduled-workflow-deliveries": "./src/queries/scheduled-workflow-deliveries.ts",
    "./queries/relationship-agenda": "./src/queries/relationship-agenda.ts",
    "./queries/relationship-context-search": "./src/queries/relationship-context-search.ts",
    "./queries/semantic-retrieval": "./src/queries/semantic-retrieval.ts",
    "./queries/weekly-relationship-review": "./src/queries/weekly-relationship-review.ts",
    "./queries/source-records": "./src/queries/source-records.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "biome check src drizzle.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "TMPDIR=/tmp tsx src/seed.ts",
    "db:eval:reset": "TMPDIR=/tmp tsx src/eval/reset.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@tendnote/domain": "workspace:*",
    "ai": "7.0.2",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@tendnote/config": "workspace:*",
    "@types/node": "^20.19.43",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
