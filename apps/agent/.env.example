# Eve agent env — copy to `apps/agent/.env.local`. `eve dev` loads .env.local
# from THIS directory (apps/agent), NOT the repo root.

# REQUIRED to drive the agent's model. The default model (anthropic/claude-haiku-4.5) is
# routed through the Vercel AI Gateway, so it needs a gateway key. Without it,
# eve reports "model provider not linked" and prompts you with /model. As
# alternatives, pull a VERCEL_OIDC_TOKEN with `vercel link`, or switch agent.ts
# to a direct-provider AI SDK package and set that provider's key instead.
AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=

# Hosted Eve verifies Better Auth sessions directly. These values must match the
# web app. Both auth values and REDIS_URL are required in production.
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=
# REDIS_URL=redis://localhost:56379

# --- Everything below is optional ---

# Gateway model id for the agent (default: anthropic/claude-haiku-4.5).
# TENDNOTE_AGENT_MODEL=anthropic/claude-haiku-4.5
# Separate model id for generated relationship snapshots (defaults to
# TENDNOTE_AGENT_MODEL when unset).
# TENDNOTE_SNAPSHOT_MODEL=anthropic/claude-haiku-4.5
# Semantic embedding model id. Defaults to openai/text-embedding-3-small when
# AI Gateway credentials are present, otherwise local dev falls back to
# deterministic fake vectors.
# TENDNOTE_EMBEDDING_MODEL=openai/text-embedding-3-small
# Structured Suggested Memory and General Action extraction. Defaults to the stable,
# cost-efficient extraction tier below when unset.
# TENDNOTE_EXTRACTION_MODEL=google/gemini-3.1-flash-lite
# TENDNOTE_EMBEDDING_VERSION=openai/text-embedding-3-small
# TENDNOTE_EMBEDDING_RUNTIME=inline

# Postgres for the agent's tool reads/writes. Defaults to the local docker
# instance below when unset.
# DATABASE_URL=postgres://tendnote:tendnote@localhost:55432/tendnote
# Optional. Tendnote requires the transaction-capable Postgres driver, including for
# Neon databases. Leave unset or set explicitly to "postgres".
# DATABASE_DRIVER=postgres

# Local-date boundary for the four app-owned scheduled workflows. Hosted runs
# discover owners from durable granted access profiles; no production owner id is
# configured here.
# TENDNOTE_BRIEF_TIMEZONE=America/Chicago

# Loopback-only local Eve and scheduled-workflow owner. Hosted Eve requests require
# a valid Better Auth session, and hosted schedules never use this fallback.
# TENDNOTE_DEV_OWNER_USER_ID=demo-user

# Discord private capture channel setup. The bot token/public key/application id
# are configured in the Discord Developer Portal.
# DISCORD_APPLICATION_ID=
# DISCORD_PUBLIC_KEY=
# DISCORD_BOT_TOKEN=

# DISCORD_OWNER_USER_MAP is a private-beta / dev fallback only, not the hosted
# SaaS resolution path. See docs/discord-setup.md §6 for resolution order.
# DISCORD_OWNER_USER_MAP=discord-user-id:tendnote-owner-user-id
