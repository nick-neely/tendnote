{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "npx turbo-ignore --fallback=HEAD^1",
  "crons": [
    {
      "path": "/api/cron/background-jobs",
      "schedule": "*/10 * * * *"
    }
  ],
  "functions": {
    "src/app/api/queue/extraction/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "tendnote-extraction-v1"
        }
      ]
    },
    "src/app/api/queue/embedding/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "tendnote-embedding-v1"
        }
      ]
    },
    "src/app/api/queue/reminder/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "tendnote-reminder-push-v1"
        }
      ]
    }
  }
}
