{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "pnpm exec turbo query affected --base=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^1} --packages=@tendnote/web --exit-code",
  "crons": [
    {
      "path": "/api/cron/background-jobs",
      "schedule": "*/10 * * * *"
    }
  ],
  "functions": {
    "src/app/api/queue/extraction/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "tendnote-extraction-v1"
        }
      ]
    },
    "src/app/api/queue/embedding/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "tendnote-embedding-v1"
        }
      ]
    },
    "src/app/api/queue/reminder/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "tendnote-reminder-push-v1"
        }
      ]
    },
    "src/app/api/queue/owner-data-export/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "tendnote-owner-data-export-v1"
        }
      ]
    }
  },
  "routes": [
    {
      "src": "/.*",
      "has": [
        {
          "type": "header",
          "key": "next-router-prefetch",
          "value": "1"
        },
        {
          "type": "header",
          "key": "next-router-segment-prefetch"
        }
      ],
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "next-router-prefetch"
          },
          "args": "2"
        }
      ],
      "continue": true
    }
  ]
}
