# Web app env — copy to `apps/web/.env.local`. Next.js loads .env.local from THIS
# directory (apps/web), NOT the repo root.

# REQUIRED for the conversational web chat: base URL of the running Eve service.
# `eve dev` prints this on startup and defaults to port 2000. The deterministic
# capture path never reaches Eve, so chat is the only feature that needs it.
TENDNOTE_EVE_URL=http://localhost:2000

# --- Everything below is optional: each has a working local default ---

# Postgres. Defaults to the local docker instance below when unset.
# DATABASE_URL=postgres://tendnote:tendnote@localhost:55432/tendnote
# Set to "neon-http" when DATABASE_URL points at Neon.
# DATABASE_DRIVER=

# Redis for Better Auth sessions. Defaults to the local docker instance below.
# REDIS_URL=redis://localhost:56379

# Better Auth. A local dev secret is used automatically when unset; both are
# REQUIRED in production. Generate a secret with `openssl rand -base64 32`.
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=

# Vercel AI Gateway key — only needed for LLM-generated relationship snapshots.
# Without it (or a VERCEL_OIDC_TOKEN from `vercel link`), snapshots fall back to
# the deterministic generator.
# AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=
# Snapshot model id. Defaults to TENDNOTE_AGENT_MODEL, then openai/gpt-5.4-mini.
# TENDNOTE_SNAPSHOT_MODEL=openai/gpt-5.4-mini

# Dev-only owner scoping. Falls back to "demo-user" when no session is present.
# TENDNOTE_DEV_OWNER_USER_ID=demo-user
