    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-table": "^8.21.3",
    "@tendnote/agent": "workspace:*",
    "@tendnote/auth": "workspace:*",
    "@tendnote/db": "workspace:*",
    "@tendnote/domain": "workspace:*",
    "@tendnote/rate-limit": "workspace:*",
    "@tiptap/core": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@vercel/queue": "^0.3.1",
    "ai": "7.0.59",
    "better-auth": "^1.6.20",
    "better-call": "1.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "eve": "^0.32.0",
    "flags": "^4.2.0",
    "ioredis": "^5.8.2",
    "nanoid": "^6.0.1",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-email": "6.9.2",
    "resend": "6.19.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
