{
  "name": "@tendnote/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "email:dev": "email dev --dir src/lib/email/templates --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "biome check src tests playwright.config.ts next.config.ts postcss.config.mjs components.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "build:instant": "TENDNOTE_INSTANT_MATRIX=1 next build",
    "test:instant": "pnpm build:instant && TENDNOTE_INSTANT_MATRIX=1 playwright test",
    "test:instant:full": "pnpm build:instant && TENDNOTE_INSTANT_MATRIX=1 TENDNOTE_INSTANT_SCOPE=full playwright test"
  },
  "dependencies": {
