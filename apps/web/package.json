    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-table": "^9.2.4",
    "@tendnote/agent": "workspace:*",
    "@tendnote/auth": "workspace:*",
    "@tendnote/db": "workspace:*",
    "@tendnote/domain": "workspace:*",
    "@tendnote/rate-limit": "workspace:*",
    "@tiptap/core": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@vercel/queue": "^0.5.1",
    "ai": "7.0.84",
    "better-auth": "^1.7.2",
    "better-call": "1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "eve": "^0.47.3",
    "flags": "^4.3.0",
    "ioredis": "^6.0.0",
    "nanoid": "^6.0.1",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "radix-ui": "1.6.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-email": "6.9.3",
    "resend": "6.25.0",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
