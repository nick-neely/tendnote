{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignoreExports": [
    {
      "file": "apps/web/src/components/ai-elements/**",
      "exports": ["*"]
    },
    {
      "file": "apps/web/src/components/ui/**",
      "exports": ["*"]
    },
    {
      // Vitest Browser Mode resolves these named stubs through Vite aliases in
      // vitest.browser.config.ts, so the import-based scan cannot see the uses.
      "file": "apps/web/src/test/browser-actions.ts",
      "exports": ["*"]
    },
    {
      // These lightweight review-card stubs are also consumed only through
      // Vitest Browser Mode aliases in vitest.browser.config.ts.
      "file": "apps/web/src/test/browser-review-components.tsx",
      "exports": ["*"]
    }
  ],
  // babel-plugin-react-compiler: loaded implicitly by Next's `reactCompiler: true`
  //   (apps/web/next.config.ts), not via a direct import.
  // @tendnote/agent: the web app mounts Eve same-origin via `withEve(..., { eveRoot:
  //   "../agent" })` in next.config.ts (a filesystem path, not an import), and CI
  //   deploys web after agent (see "ci: mark web deployment dependent on agent").
  //   The workspace edge is deliberate but invisible to the import-based scan.
  "ignoreDependencies": ["babel-plugin-react-compiler", "@tendnote/agent"],
  "entry": [
    "apps/agent/agent/agent.ts",
    // Registered by URL from pwa-registration.tsx, so no import edge exists.
    "apps/web/public/sw.js"
  ],
  "dynamicallyLoaded": [
    "apps/agent/agent/channels/**/*.ts",
    "apps/agent/agent/connections/**/*.ts",
    "apps/agent/agent/hooks/**/*.ts",
    "apps/agent/agent/instructions/**/*.ts",
    "apps/agent/agent/schedules/**/*.ts",
    "apps/agent/agent/sandbox/**/*.ts",
    "apps/agent/agent/subagents/**/agent.ts",
    // Eve resolves the default tool harness per agent node, so a subagent's
    // `tools/` files (its own authored tools and its `disableTool()` opt-outs)
    // are loaded by path exactly like the root's, with no import edge either.
    "apps/agent/agent/subagents/**/tools/**/*.ts",
    "apps/agent/agent/tools/**/*.ts",
    // Eve eval suites are discovered and executed by `eve eval` (see apps/agent
    //   package.json `eval:*` scripts) via a filesystem glob over `*.eval.ts`,
    //   not via any import edge, so the import-based scan cannot see them. The
    //   Phase 5 boundary test (apps/agent/tests/phase-5-boundaries.test.ts)
    //   asserts specific eval files stay present, so they are load-bearing.
    "apps/agent/evals/**/*.eval.ts"
  ],
  "duplicates": {
    "mode": "mild",
    "minTokens": 70,
    "minLines": 6,
    "threshold": 0,
    "ignore": [
      "apps/web/src/components/ai-elements/**",
      "apps/web/src/components/ui/**",
      "packages/db/src/schema/**"
    ]
  },
  "health": {
    "ignore": [
      "apps/web/src/components/ai-elements/**",
      "apps/web/src/components/ui/**",
      // A browser event dispatcher with intentional fetch-policy branches.
      "apps/web/public/sw.js",
      // A standalone reporting utility, not runtime product code.
      "scripts/loc-inventory.mjs",
      // The household purge sweep's live check: a hand-run verification script
      // (`pnpm --filter @tendnote/db db:purge:check`) that seeds a real Postgres
      // and asserts the delete order against it. Its own header states it is
      // deliberately not in the suite, because what it proves is the one thing an
      // in-memory store cannot. Both of its findings exceeded on CRAP alone,
      // complexity multiplied by untestedness, with raw cyclomatic inside the
      // thresholds, so the score was measuring the absence of unit coverage that
      // the file exists specifically to do without. Same reason as the line above:
      // a verification utility, not runtime product code.
      "packages/db/src/household-purge-live-check.ts",
      // Same shape, same reason: the Assistant conversation owner-scoping live
      // check (`pnpm --filter @tendnote/db db:assistant-conversations:check`)
      // proves against a real Postgres that a pre-claimed session id resists the
      // other account's writes. Deliberately not in the suite; its CRAP score is
      // the absence of unit coverage the file exists to do without.
      "packages/db/src/assistant-conversations-live-check.ts"
    ]
  },
  "audit": {
    "gate": "new-only",
    // A baseline records the state accepted at the end of a delivered epic, so the
    // cumulative PR gate reports regressions introduced *after* the per-ticket
    // reviews rather than the whole standing backlog. Phase Seven set the first
    // pair (#276); the Next.js 16.3 instant-navigation epic (#301-#309) superseded
    // it; this pair supersedes that one at the end of Phase Eight (#376, issues
    // #378-#391, all implemented, reviewed, and closed).
    //
    // Unlike the last handover this one did not inherit a dead baseline: the 16.3
    // dupes half still matched 34 of its 68 entries repo-wide. It is superseded
    // because Phase Eight is a delivered epic, which is the only point at which
    // this file may move, not because the old pair had stopped working.
    //
    // A "matched 0 current clone groups" warning is not by itself a dead baseline:
    // a scoped audit matches nothing when the changeset touches no duplicated file.
    // Tell the two apart with a repo-wide `fallow dupes` run — the baseline note
    // records how.
    //
    // What this pair accepts, and what it does NOT, is written down in
    // docs/verification/nextjs-16-3-fallow-baseline.md. Read that before adding to
    // it: a baseline is for findings a review consciously accepted, never a way to
    // land a new one. What Phase Eight accepted is itemised there and tracked for
    // paydown in #394.
    "healthBaseline": "fallow-baselines/phase-8-health.json",
    "dupesBaseline": "fallow-baselines/phase-8-dupes.json"
  }
}
