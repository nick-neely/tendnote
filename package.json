{
  "name": "tendnote",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @tendnote/web dev",
    "dev:agent": "pnpm --filter @tendnote/agent dev",
    "build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "fallow": "fallow audit",
    "fallow:ci": "fallow audit --ci",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health --score --hotspots",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:check": "pnpm --filter @tendnote/db db:check",
    "db:generate": "pnpm --filter @tendnote/db db:generate",
    "db:migrate": "pnpm --filter @tendnote/db db:migrate",
    "db:seed": "pnpm --filter @tendnote/db db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "fallow": "^2.102.0",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3"
  }
}
