{
  "name": "tendnote",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "turbo run dev --filter=@tendnote/web",
    "dev:web": "pnpm --filter @tendnote/web dev",
    "dev:agent": "pnpm --filter @tendnote/agent dev",
    "build": "turbo run build --filter=@tendnote/web --only",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "fallow": "fallow audit",
    "fallow:ci": "fallow audit --ci --coverage coverage/coverage-final.json",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health --score --hotspots",
    "fallow:coverage:check": "node scripts/assert-fallow-coverage.mjs",
    "coverage:ci": "node scripts/collect-test-coverage.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "turbo typecheck",
    "test": "vitest run scripts/*.test.ts && turbo test",
    "test:browser": "pnpm --filter @tendnote/web test:browser",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:check": "pnpm --filter @tendnote/db db:check",
    "db:generate": "pnpm --filter @tendnote/db db:generate",
    "db:migrate": "pnpm --filter @tendnote/db db:migrate",
    "db:studio": "pnpm --filter @tendnote/db db:studio",
    "db:seed": "pnpm --filter @tendnote/db db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@vitest/coverage-istanbul": "^4.1.9",
    "fallow": "^2.102.0",
    "istanbul-lib-coverage": "^3.2.2",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "volta": {
    "node": "24.18.0"
  }
}
