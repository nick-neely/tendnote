DATABASE_URL=postgres://tendnote:tendnote@localhost:55432/tendnote
REDIS_URL=redis://localhost:56379

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
NEXT_PUBLIC_APP_URL=http://localhost:3000

TENDNOTE_ENV=local

# Dev-only owner scoping. Web + Eve fall back to "demo-user" when no session
# is present; override to capture under a specific owner id locally.
# TENDNOTE_DEV_OWNER_USER_ID=demo-user
# Make @tendnote/db throw instead of falling back to mock seed data when the
# database is unreachable.
# TENDNOTE_STRICT_DB=true

# --- Eve agent (only needed to run the conversational assistant) ---
# The deterministic memory-capture loop does NOT require a model. These are
# only needed for the Eve agent to drive tools from natural language.
# Gateway model id (default: openai/gpt-5.4-mini).
# TENDNOTE_AGENT_MODEL=openai/gpt-5.4-mini
# Vercel AI Gateway key for gateway-routed model ids (or use `vercel link` for
# VERCEL_OIDC_TOKEN). Alternatively, switch to a direct provider AI SDK package
# and set that provider's key instead (e.g. OPENAI_API_KEY, ANTHROPIC_API_KEY).
# AI_GATEWAY_API_KEY=
