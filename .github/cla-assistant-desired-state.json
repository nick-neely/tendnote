{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "kind": "cla-assistant-desired-state",
  "runtimeConfig": false,
  "service": {
    "name": "CLA Assistant",
    "url": "https://cla-assistant.io",
    "configuration": "owner dashboard and linked Gist; this file is not read by the hosted service"
  },
  "repository": "nick-neely/tendnote",
  "defaultBranch": "main",
  "agreement": {
    "path": "docs/legal/individual-contributor-license-agreement.md",
    "gistFilename": "individual-contributor-license-agreement.md",
    "version": "1.0",
    "effectiveDate": "2026-08-21",
    "sha256": "c3a8e1828d9d573dedba7ddb9e38fb043032532777db9e6028c4b99e4a5545ec"
  },
  "metadata": {
    "path": "docs/legal/cla-assistant-metadata.json",
    "gistFilename": "metadata",
    "sha256": "2388463bcb86f1cf3a2ec38ab156060c2c553c63678c6e41bf7422d62e4adb3c"
  },
  "enforcement": {
    "required": true,
    "observeBeforeEnforce": true,
    "statusContext": {
      "value": "license/cla",
      "placeholder": "CLA_STATUS_CONTEXT_TO_OBSERVE_LIVE",
      "integrationId": 128106,
      "integrationIdPlaceholder": "CLA_INTEGRATION_ID_TO_OBSERVE_LIVE"
    },
    "rulesetId": 19995472,
    "trackedRulesetPath": ".github/rulesets/protect-main.json",
    "existingRequiredStatusContexts": [
      "Detect changes",
      "verify / Quality",
      "verify / Test and Fallow",
      "verify / Instant matrix",
      "verify / Database",
      "Vercel",
      "license/cla"
    ],
    "preserveExistingChecks": true,
    "removeExistingBypassActors": false,
    "desiredBypassActors": [
      {
        "actorId": 5,
        "actorType": "RepositoryRole",
        "bypassMode": "pull_request"
      }
    ],
    "requiresPostUpdateVerification": true,
    "claAssistantAllowlist": [],
    "maintainerOverride": true,
    "maintainerOverrideScope": "repository administrators may consciously bypass pull-request rules; this is not an automatic CLA exemption"
  },
  "routes": {
    "individual": {
      "records": ["individual-cla-acceptance"],
      "statusRequirement": "required",
      "bypass": false
    },
    "employer": {
      "records": ["individual-cla-acceptance", "employer-contribution-authorization"],
      "statusRequirement": "required",
      "bypass": false
    },
    "corporate": {
      "records": ["corporate-contributor-license-agreement", "authorized-contributor-schedule"],
      "statusRequirement": "required",
      "bypass": false
    }
  },
  "privacy": {
    "acceptanceRecords": "private",
    "publicPullRequestData": "minimum status context only",
    "proof": "redacted schema only; no signature records"
  }
}
