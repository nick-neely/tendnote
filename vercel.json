{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm turbo run build --filter=@tendnote/web...",
  "outputDirectory": "apps/web/.next",
  "crons": [
    {
      "path": "/api/cron/background-jobs",
      "schedule": "*/10 * * * *"
    }
  ],
  "functions": {
    "apps/web/src/app/api/queue/extraction/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "tendnote-extraction-v1"
        }
      ]
    },
    "apps/web/src/app/api/queue/embedding/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "tendnote-embedding-v1"
        }
      ]
    }
  }
}
